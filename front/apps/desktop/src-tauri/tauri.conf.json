{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropAgentX",
  "version": "0.1.0",
  "identifier": "com.dropagentx.desktop",
  "build": {
    "beforeBuildCommand": "pnpm -C ../.. build:root",
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../.. --filter @agent-one/shell run dev"
  },
  "app": {
    "windows": [
      {
        "title": "DropAgentX — Agent-One",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "appimage", "deb", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
