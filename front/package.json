{
  "name": "agent-one",
  "private": true,
  "description": "Agent-One front monorepo — packages/* foundation (Step 2) + apps/* (Step 3+: shell, dashboard, webapp, site). The frozen backend lives in ../rust — zero coupling.",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "pnpm --filter @agent-one/api-client run generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:urls": "node scripts/check-no-raw-urls.mjs",
    "build:root": "node scripts/build-static-root.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm lint:urls",
    "ui:build": "pnpm --filter @agent-one/ui run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "happy-dom": "^18.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
